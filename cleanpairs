#!/usr/bin/env python3
"""Build a clean dataset of text-image pairs from raw Instagram post metadata.

Steps: load -> rename columns -> dedupe IDs -> pick one image per post ->
normalize captions -> verify images open -> dedupe (caption + image bytes) ->
group-aware train/val/test split -> save clean data, drop log, and report.

Example:
  python clean_pairs.py --input raw.csv --image-dir images/ \
      --id-col shortcode --text-col caption --image-col image_file \
      --label-col stance --group-col username --out-dir clean/
"""
import argparse
import hashlib
import json
import re
import unicodedata
from pathlib import Path

import numpy as np
import pandas as pd
from PIL import Image

URL_RE = re.compile(r"https?://\S+|www\.\S+")
WS_RE = re.compile(r"\s+")


def load(path: Path) -> pd.DataFrame:
    s = path.suffix.lower()
    if s == ".csv":
        return pd.read_csv(path)
    if s == ".tsv":
        return pd.read_csv(path, sep="\t")
    if s == ".parquet":
        return pd.read_parquet(path)
    if s == ".jsonl":
        return pd.read_json(path, lines=True)
    if s == ".json":
        return pd.read_json(path)
    raise ValueError(f"Unsupported input format: {s}")


def first_image(v):
    """Carousels: keep the FIRST image. Handles lists, JSON lists, 'a.jpg|b.jpg'."""
    if isinstance(v, (list, tuple, np.ndarray)):
        return str(v[0]) if len(v) else None
    if v is None or (isinstance(v, float) and np.isnan(v)):
        return None
    v = str(v).strip()
    if v.startswith("["):
        try:
            lst = json.loads(v)
            return str(lst[0]) if lst else None
        except json.JSONDecodeError:
            pass
    return re.split(r"[|;]", v)[0].strip() or None


def clean_text(t, strip_urls=True):
    if not isinstance(t, str):
        return ""
    t = unicodedata.normalize("NFC", t)
    if strip_urls:
        t = URL_RE.sub(" ", t)
    # Hashtags, @mentions and emojis are deliberately KEPT (possible stance signal).
    return WS_RE.sub(" ", t).strip()


def check_image(path: Path, min_side: int):
    """Return (ok, md5, width, height, reason)."""
    if not path.is_file():
        return False, None, None, None, "image_missing"
    try:
        data = path.read_bytes()
        with Image.open(path) as im:
            im.verify()
        with Image.open(path) as im:  # reopen: verify() invalidates the handle
            im = im.convert("RGB")
            w, h = im.size
        if min(w, h) < min_side:
            return False, None, w, h, "image_too_small"
        return True, hashlib.md5(data).hexdigest(), w, h, ""
    except Exception:
        return False, None, None, None, "image_corrupt"


def group_split(df, group_col, fracs, seed):
    """Assign split so no group (e.g. account) spans multiple splits."""
    rng = np.random.default_rng(seed)
    if group_col and group_col in df:
        groups = np.array(df[group_col].fillna("__none__").astype(str).unique(), dtype=object)
        rng.shuffle(groups)
        n = len(groups)
        a = int(round(fracs[0] * n))
        b = a + int(round(fracs[1] * n))
        m = {g: "train" for g in groups[:a]}
        m.update({g: "val" for g in groups[a:b]})
        m.update({g: "test" for g in groups[b:]})
        return df[group_col].fillna("__none__").astype(str).map(m)
    r = rng.random(len(df))
    return pd.Series(np.where(r < fracs[0], "train",
                     np.where(r < fracs[0] + fracs[1], "val", "test")), index=df.index)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--input", required=True)
    ap.add_argument("--image-dir", default=".", help="prefix for relative image paths")
    ap.add_argument("--id-col", required=True)
    ap.add_argument("--text-col", required=True)
    ap.add_argument("--image-col", required=True)
    ap.add_argument("--label-col", default=None)
    ap.add_argument("--group-col", default=None, help="e.g. username; keeps accounts within one split")
    ap.add_argument("--out-dir", default="clean")
    ap.add_argument("--min-chars", type=int, default=3, help="min caption length after cleaning")
    ap.add_argument("--min-side", type=int, default=64, help="min image width/height in px")
    ap.add_argument("--keep-urls", action="store_true")
    ap.add_argument("--split", default="0.8,0.1,0.1", help="train,val,test fractions")
    ap.add_argument("--seed", type=int, default=42)
    a = ap.parse_args()

    out = Path(a.out_dir)
    out.mkdir(parents=True, exist_ok=True)
    fracs = [float(x) for x in a.split.split(",")]
    assert abs(sum(fracs) - 1) < 1e-6 and len(fracs) == 3, "--split must sum to 1"

    raw = load(Path(a.input))
    n0 = len(raw)
    cols = {a.id_col: "post_id", a.text_col: "caption_raw", a.image_col: "image_raw"}
    if a.label_col:
        cols[a.label_col] = "label"
    if a.group_col:
        cols[a.group_col] = "group"
    df = raw.rename(columns=cols)[list(cols.values())].copy()

    drops = []

    def drop(mask, reason):
        nonlocal df
        for pid in df.loc[mask, "post_id"]:
            drops.append({"post_id": pid, "reason": reason})
        df = df[~mask].copy()

    # 1. duplicate / missing IDs
    drop(df["post_id"].isna(), "missing_id")
    drop(df.duplicated("post_id", keep="first"), "duplicate_post_id")

    # 2. one image per post
    df["image_rel"] = df["image_raw"].map(first_image)
    drop(df["image_rel"].isna(), "no_image_listed")
    df["image_path"] = df["image_rel"].map(lambda p: str(Path(a.image_dir) / p))

    # 3. caption normalization
    df["caption"] = df["caption_raw"].map(lambda t: clean_text(t, not a.keep_urls))
    drop(df["caption"].str.len() < a.min_chars, "caption_empty_or_too_short")

    # 4. verify images (slowest step)
    res = df["image_path"].map(lambda p: check_image(Path(p), a.min_side))
    df["img_ok"] = res.map(lambda r: r[0])
    df["image_md5"] = res.map(lambda r: r[1])
    df["width"] = res.map(lambda r: r[2])
    df["height"] = res.map(lambda r: r[3])
    reasons = res.map(lambda r: r[4])
    for pid, rs in zip(df.loc[~df["img_ok"], "post_id"], reasons[~df["img_ok"]]):
        drops.append({"post_id": pid, "reason": rs})
    df = df[df["img_ok"]].copy()

    # 5. content duplicates (same caption AND same image bytes)
    drop(df.duplicated(["caption", "image_md5"], keep="first"), "duplicate_caption_and_image")

    # 6. split
    df["split"] = group_split(df, "group" if a.group_col else None, fracs, a.seed)

    keep = ["post_id", "caption", "image_path", "width", "height", "image_md5", "split"]
    keep += [c for c in ("label", "group") if c in df]
    df[keep].reset_index(drop=True).to_csv(out / "clean_pairs.csv", index=False)
    pd.DataFrame(drops).to_csv(out / "drop_log.csv", index=False)

    # 7. report
    lines = [f"Input rows: {n0}", f"Kept: {len(df)}", f"Dropped: {len(drops)}"]
    if drops:
        lines += ["", "Drops by reason:"] + [f"  {k}: {v}" for k, v in
                                              pd.DataFrame(drops)["reason"].value_counts().items()]
    lines += ["", "Split sizes:"] + [f"  {k}: {v}" for k, v in df["split"].value_counts().items()]
    if "label" in df:
        lines += ["", "Label distribution by split:",
                  df.groupby("split")["label"].value_counts().to_string()]
    lines += ["", f"Caption length (chars): median={int(df['caption'].str.len().median())}, "
                  f"p95={int(df['caption'].str.len().quantile(.95))}"]
    (out / "report.txt").write_text("\n".join(lines))
    print("\n".join(lines))


if __name__ == "__main__":
    main()
